{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "geyser_custom:eg_msr",
      "materials": {
        "default": "entity_alphatest_one_sided",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/endernation/generated/msr",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.endernation.msr"
      },
      "animations": {
        "firstperson_righthand": "animation.endernation.msr.firstperson_righthand",
        "firstperson_lefthand": "animation.endernation.msr.firstperson_lefthand",
        "thirdperson_righthand": "animation.endernation.msr.thirdperson_righthand",
        "thirdperson_lefthand": "animation.endernation.msr.thirdperson_lefthand",
        "head": "animation.endernation.msr.head",
        "hide_head": "animation.endernation.msr.hide_head"
      },
      "scripts": {
        "animate": [
          {
            "firstperson_righthand": "c.is_first_person && c.item_slot == 'main_hand'"
          },
          {
            "firstperson_lefthand": "c.is_first_person && c.item_slot == 'off_hand'"
          },
          {
            "thirdperson_righthand": "!c.is_first_person && c.item_slot == 'main_hand'"
          },
          {
            "thirdperson_lefthand": "!c.is_first_person && c.item_slot == 'off_hand'"
          },
          {
            "head": "!c.is_first_person && c.item_slot == 'head'"
          },
          {
            "hide_head": "c.is_first_person && c.item_slot == 'head'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
